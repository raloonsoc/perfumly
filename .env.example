# DATABASE
POSTGRES_DB=perfumly_db
POSTGRES_USER=perfumly_user
# openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_PASSWORD=changeme

# REDIS
# openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
REDIS_PASSWORD=changeme

# JWT
# openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
JWT_SECRET=changeme

# RESEND
RESEND_API_KEY=changeme
EMAIL_FROM=changeme@example.com

# ADMIN BOOTSTRAP (optional)
# Email of an already registered and verified account. On startup, if there is no
# active (non-blocked) admin, this account is promoted to ADMIN. Leave empty to disable.
ADMIN_BOOTSTRAP_EMAIL=


# Backend
SPRING_PROFILES_ACTIVE=prod

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
